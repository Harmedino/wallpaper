# React frontend + Next.js Node.js APIs + separate Node.js worker + MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/wallpaper
APP_URL=http://localhost:3000
# At least 32 random characters; npm run setup:local generates a local value.
SESSION_SECRET=
# scrypt salt:hash. Use npm run admin:password with password supplied on stdin.
ADMIN_PASSWORD_HASH=
STORAGE_PROVIDER=local
STORAGE_DIR=.data/media
# Production: STORAGE_PROVIDER=r2; keep bucket private (no r2.dev public access).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# none | local | realesrgan | replicate
AI_PROVIDER=none
REALESRGAN_URL=
REALESRGAN_TOKEN=
REPLICATE_API_TOKEN=
# Optional: pin a Real-ESRGAN model version; otherwise resolved automatically from Replicate
REPLICATE_MODEL_VERSION=
# Exact extra image hosts, e.g. replicate.delivery,pbxt.replicate.delivery
IMAGE_ALLOWED_HOSTS=
SOURCE_USER_AGENT=Wallspace/1.0 (replace with your contact email before enabling discovery)
# For Vercel uploads without R2: STORAGE_PROVIDER=mongodb (GridFS).
# Vercel automatically substitutes mongodb when local storage is selected.
# Use the same STORAGE_PROVIDER=mongodb on your external processing worker.
# Vercel sends this secret as a Bearer token to the weekly cron endpoint.
CRON_SECRET=

# Optional persistent-worker CPU Real-ESRGAN (not a Vercel serverless runtime):
REALESRGAN_PYTHON=python
REALESRGAN_MODEL=.data/models/realesr-general-x4v3.pth
# Optional 8K also requires outputMegapixels >= 33 in Admin limits.
ENABLE_8K=false
# Optional persistent ingestion worker OCR binary:
WATERMARK_OCR_COMMAND=tesseract
IMPORT_TARGET=1000
IMPORT_MAX_MINUTES=120

# Optional paid AI background expansion (Flux Fill Pro); same private Replicate token.
OUTPAINT_PROVIDER=none
# Keep true on a persistent worker to drain durable weekly imports.
INGESTION_WORKER_ENABLED=true
